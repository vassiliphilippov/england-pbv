{% extends "base.j2" %}
{% block head %}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
{% endblock %}
{% block content %}
<section class="hero">
  <h1>Every hill in England, measured for its view</h1>
  <p class="lede">
    This site searched the whole of England &mdash; 52 million terrain cells &mdash; for places with the
    geometry of a great panorama: a steep drop at your feet, a wide unobstructed horizon, long
    sightlines over lower country, and a varied visible landscape. No ratings, no likes &mdash; only
    physics: {{ n_candidates }} candidate spots ranked by objective <em>view&nbsp;potential</em>.
  </p>
  <p class="fine">
    Inspired by the view from Coombe Hill Monument. Each viewpoint was fine-tuned with a
    12.5-metre local search to find the exact best place to stand.
  </p>
  <form class="postcode-form" action="postcode.html" method="get">
    <input type="text" name="postcode" placeholder="Your postcode, e.g. HP22 6NE" required
           autocomplete="postal-code" aria-label="Postcode">
    <button type="submit">Best views near me &rarr;</button>
    <span class="area-note">driving-time ladder of ever-better views from your door</span>
  </form>
</section>

<div id="map"></div>
<div class="map-legend">
  Colour = view potential:
  <span class="dot" style="background:#c9c39b"></span>60
  <span class="dot" style="background:#7fae72"></span>70
  <span class="dot" style="background:#2f6f4f"></span>80
  <span class="dot" style="background:#1d4436"></span>90+
  &middot; click a point for details &middot; zoomed out: the national top {{ n_map_points }};
  zoom in and every one of the {{ n_all_points }} candidate viewpoints appears.
</div>
<div class="area-panel">
  <button id="england-btn">&#8630; Back to all of England</button>
  <span class="area-note">the list below follows the map &mdash; zoom or pan anywhere and the best
  views in the visible area rank themselves automatically</span>
  <div id="area-results"></div>
</div>

<div class="grid-2">
  <section>
    <h2>Top 50 in England</h2>
    <table class="rank">
      <tr><th>#</th><th>Place</th><th>Region</th><th class="num">Score</th></tr>
      {% for row in top_overall %}
      <tr>
        <td class="num">{{ loop.index }}</td>
        <td>{% if row.slug %}<a href="viewpoints/{{ row.slug }}.html">{{ row.name }}</a>{% else %}{{ row.name }}{% endif %}
            {% if row.is_discovery %}<span class="tag">discovery</span>{% endif %}</td>
        <td>{{ row.region }}</td>
        <td class="num"><span class="score-pill">{{ "%.1f"|format(row.score) }}</span></td>
      </tr>
      {% endfor %}
    </table>
  </section>
  <section>
    <h2>Best inland patchwork views</h2>
    <p class="note">The Coombe Hill kind: escarpments and hills over farmland vales (little visible sea).</p>
    <table class="rank">
      <tr><th>#</th><th>Place</th><th>Region</th><th class="num">Score</th></tr>
      {% for row in top_inland %}
      <tr>
        <td class="num">{{ loop.index }}</td>
        <td>{% if row.slug %}<a href="viewpoints/{{ row.slug }}.html">{{ row.name }}</a>{% else %}{{ row.name }}{% endif %}
            {% if row.is_discovery %}<span class="tag">discovery</span>{% endif %}</td>
        <td>{{ row.region }}</td>
        <td class="num"><span class="score-pill">{{ "%.1f"|format(row.score) }}</span></td>
      </tr>
      {% endfor %}
    </table>

    <h2>Best coastal panoramas</h2>
    <table class="rank">
      <tr><th>#</th><th>Place</th><th>Region</th><th class="num">Score</th></tr>
      {% for row in top_coastal %}
      <tr>
        <td class="num">{{ loop.index }}</td>
        <td>{% if row.slug %}<a href="viewpoints/{{ row.slug }}.html">{{ row.name }}</a>{% else %}{{ row.name }}{% endif %}</td>
        <td>{{ row.region }}</td>
        <td class="num"><span class="score-pill">{{ "%.1f"|format(row.score) }}</span></td>
      </tr>
      {% endfor %}
    </table>
  </section>
</div>

<section>
  <h2>Hidden gems</h2>
  <p class="note">
    High-scoring spots with no marked viewpoint, no named hill &mdash; places the algorithm found on its
    own that nobody has tagged on a map. Potentially beautiful, genuinely unheralded.
  </p>
  <table class="rank">
    <tr><th>#</th><th>Location</th><th>Region</th><th class="num">Nat. rank</th><th class="num">Score</th></tr>
    {% for row in hidden_gems %}
    <tr>
      <td class="num">{{ loop.index }}</td>
      <td>{% if row.slug %}<a href="viewpoints/{{ row.slug }}.html">{{ row.name }}</a>{% else %}{{ row.name }}{% endif %}</td>
      <td>{{ row.region }}</td>
      <td class="num">{{ row.rank }}</td>
      <td class="num"><span class="score-pill">{{ "%.1f"|format(row.score) }}</span></td>
    </tr>
    {% endfor %}
  </table>
</section>

<script src="data/points.js"></script>
<script>
const points = {{ map_points_json|safe }};
const map = L.map('map').setView([52.8, -1.7], 6);
L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
  maxZoom: 17,
  attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
}).addTo(map);
function colorFor(s) {
  if (s >= 90) return '#1d4436';
  if (s >= 80) return '#2f6f4f';
  if (s >= 70) return '#7fae72';
  return '#c9c39b';
}
const canvas = L.canvas({ padding: 0.3 });
function popupFor(name, score, slug, lat, lon) {
  let h = '<b>' + name + '</b><br>view potential ' + score.toFixed(1) + '<br>';
  if (slug) h += '<a href="viewpoints/' + slug + '.html">details &rarr;</a> &middot; ';
  h += '<a href="https://maps.google.com/?q=' + lat + ',' + lon + '">Google Maps</a>';
  return h;
}
const inland = L.layerGroup(), coastal = L.layerGroup();
points.forEach(p => {
  const m = L.circleMarker([p.la, p.lo], {
    renderer: canvas,
    radius: p.s >= 85 ? 7 : (p.s >= 75 ? 5.5 : 4),
    fillColor: colorFor(p.s), color: '#ffffff', weight: 1, fillOpacity: 0.88
  });
  m.bindPopup(popupFor(p.n, p.s, p.u, p.la, p.lo));
  (p.w > 0.08 ? coastal : inland).addLayer(m);
});
inland.addTo(map); coastal.addTo(map);
L.control.layers(null, {'Inland views': inland, 'Coastal views': coastal}, {collapsed: false}).addTo(map);

// ALL_POINTS (data/points.js): every deduplicated candidate, for local exploration.
// Rows: [lat, lon, score, water_fraction, name, slug].
const allLayer = L.layerGroup();
let allLoaded = false;
function allPointsData() {
  // data/points.js may fail to load (offline, partial deploy): degrade to the top set.
  if (typeof ALL_POINTS === 'undefined') {
    return points.map(p => [p.la, p.lo, p.s, p.w, p.n, p.u || '']);
  }
  return ALL_POINTS;
}
function ensureAllPoints() {
  if (allLoaded) return;
  allLoaded = true;
  allPointsData().forEach(r => {
    const m = L.circleMarker([r[0], r[1]], {
      renderer: canvas, radius: 3.2,
      fillColor: colorFor(r[2]), color: 'rgba(255,255,255,0.6)', weight: 0.7, fillOpacity: 0.75
    });
    m.bindPopup(popupFor(r[4], r[2], r[5], r[0], r[1]));
    allLayer.addLayer(m);
  });
}
map.on('zoomend', () => {
  if (map.getZoom() >= 10) {
    ensureAllPoints();
    if (!map.hasLayer(allLayer)) map.addLayer(allLayer);
  } else if (map.hasLayer(allLayer)) {
    map.removeLayer(allLayer);
  }
});

// --- auto-updating "best views in this area" -------------------------------
// The list follows the map. Updates are debounced with an adaptive delay that
// tracks the measured cost of an update (VS Code-style adaptive debounce):
// delay = clamp(150ms, 2 x EMA(update duration), 1000ms). A single deliberate
// pan after a quiet spell updates immediately (leading edge); only rapid-fire
// move events are held back.
const resultsLayer = L.layerGroup().addTo(map);
const FULL_ENGLAND = { center: [52.8, -1.7], zoom: 6 };

function updateArea() {
  if (map.getZoom() >= 8) {
    ensureAllPoints();
    if (!map.hasLayer(allLayer) && map.getZoom() >= 10) map.addLayer(allLayer);
  }
  const b = map.getBounds();
  const hits = allPointsData().filter(r => b.contains([r[0], r[1]]));
  hits.sort((x, y) => y[2] - x[2]);
  const top = hits.slice(0, 15);
  resultsLayer.clearLayers();
  top.forEach((r, i) => {
    const pin = L.marker([r[0], r[1]], {
      icon: L.divIcon({
        className: 'rank-pin-wrap',
        html: '<div class="rank-pin">' + (i + 1) + '</div>',
        iconSize: [26, 26],
        iconAnchor: [13, 13]
      }),
      zIndexOffset: 1000 - i
    });
    pin.bindPopup(popupFor(r[4], r[2], r[5], r[0], r[1]));
    resultsLayer.addLayer(pin);
  });
  let rows = top.map((r, i) => {
    const name = r[5] ? '<a href="viewpoints/' + r[5] + '.html">' + r[4] + '</a>' : r[4];
    const link = ' <a href="https://maps.google.com/?q=' + r[0] + ',' + r[1] + '">map</a>';
    return '<tr><td class="num">' + (i + 1) + '</td><td>' + name + link + '</td>' +
      '<td class="num"><span class="score-pill">' + r[2].toFixed(1) + '</span></td></tr>';
  }).join('');
  const label = hits.length + ' candidate viewpoints in view; numbered pins on the map show the local top ' + top.length;
  document.getElementById('area-results').innerHTML = hits.length === 0
    ? '<p class="note">No candidate viewpoints in this view — zoom or pan to a land area of England.</p>'
    : '<p class="note">' + label + ':</p><table class="rank">' +
      '<tr><th>#</th><th>Place</th><th class="num">Score</th></tr>' + rows + '</table>';
}

let updateEmaMs = 30;   // running estimate of one update's cost
let areaTimer = null;
let lastRunAt = -1e9;
function runAreaUpdate() {
  areaTimer = null;
  const t0 = performance.now();
  updateArea();
  const took = performance.now() - t0;
  updateEmaMs = 0.7 * updateEmaMs + 0.3 * took;
  lastRunAt = performance.now();
}
function scheduleAreaUpdate() {
  const delay = Math.min(1000, Math.max(150, 2 * updateEmaMs));
  if (areaTimer !== null) clearTimeout(areaTimer);
  if (performance.now() - lastRunAt > delay + 600) {
    runAreaUpdate();          // map was at rest: respond instantly
  } else {
    areaTimer = setTimeout(runAreaUpdate, delay);
  }
}
map.on('moveend', scheduleAreaUpdate);   // moveend also fires after every zoomend

document.getElementById('england-btn').addEventListener('click', () => {
  map.setView(FULL_ENGLAND.center, FULL_ENGLAND.zoom);
});

runAreaUpdate();
</script>
{% endblock %}
