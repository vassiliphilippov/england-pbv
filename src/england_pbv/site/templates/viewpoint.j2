{% extends "base.j2" %}
{% block title %}{{ vp.name }} — view potential {{ "%.1f"|format(vp.score) }}{% endblock %}
{% block description %}Objective view metrics for {{ vp.name }}: {{ "%.0f"|format(vp.visible_area) }} km² visible, farthest sightline {{ "%.0f"|format(vp.d_max) }} km{% endblock %}
{% block content %}
<p class="crumb"><a href="{{ root }}index.html">&larr; all viewpoints</a></p>
<div class="viewpoint-head">
  <h1>{{ vp.name }}</h1>
  <span class="rankline">#{{ vp.rank }} in England &middot; {% if vp.regional_pct >= 99.5 %}the best view in its area{% else %}top {{ "%.0f"|format(100 - vp.regional_pct) }}% of its area beats it{% endif %} &middot; {{ vp.region }}</span>
</div>

<div class="card">
  <div style="display:flex; gap:28px; align-items:flex-start; flex-wrap:wrap;">
    <div class="big-score">{{ "%.1f"|format(vp.score) }}<small>view potential (percentile composite)</small></div>
    <div class="components" style="flex:1; min-width:min(340px,100%);">
      {% for comp in vp.components %}
      <div class="component">
        <div class="value">{{ "%.0f"|format(comp.value) }}</div>
        <div class="bar"><i style="width:{{ "%.0f"|format(comp.value) }}%"></i></div>
        <div class="name">{{ comp.name }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
</div>

<div class="card">
  <h3 style="margin-top:0">The view, rendered</h3>
  <img class="render-img" src="{{ root }}renders/{{ vp.render_file }}" alt="Synthetic 360-degree render of the view from {{ vp.name }}" loading="lazy">
  <div class="compass-ruler"><span>N</span><span>E</span><span>S</span><span>W</span><span>N</span></div>
  <p class="note">
    A 360&deg; render of this exact spot computed from the terrain model, tree cover and land
    cover &mdash; summer colours, afternoon light, calibrated against photographs of famous
    viewpoints. Real trees, hedges and buildings will differ in detail.
  </p>
</div>

{% if vp.views %}
<div class="card">
  <h3 style="margin-top:0">Through the camera</h3>
  <div class="views-grid">
    {% for view in vp.views %}
    <figure class="view-figure">
      <img class="render-img" src="{{ root }}renders/{{ view.file }}" alt="Rendered view {{ view.label }} from {{ vp.name }}" loading="lazy">
      <figcaption>{{ view.label }} ({{ view.azimuth }}&deg;) &mdash; 68&deg; lens</figcaption>
    </figure>
    {% endfor %}
  </div>
  <p class="note">Rendered views along the best direction{{ 's' if vp.views|length > 1 else '' }} of this panorama.</p>
</div>
{% endif %}

<div class="card">
  <h3 style="margin-top:0">The panorama</h3>
  {{ vp.horizon_svg|safe }}
  <p class="note">
    Grey silhouette: terrain skyline in each direction (720 bearings, Earth curvature and
    refraction included). Dashed green: skyline with trees (+15&nbsp;m) and buildings (+8&nbsp;m) as
    obstacles. Blue strip: how far the ground is visible on each bearing.
  </p>
</div>

<div class="two-col-cards">
  <div class="card" style="display:flex; gap:18px; align-items:center; flex-wrap:wrap;">
    {{ vp.polar_svg|safe }}
    <div>
      <h3 style="margin-top:0">Where the view opens</h3>
      <p class="note">Wedge length = distance to the farthest visible ground on that bearing
      (vegetation-aware). Rings at 10, 25 and 50&nbsp;km.</p>
    </div>
  </div>
  <div class="card">
    <h3 style="margin-top:0">What fills the view</h3>
    <div class="lc-bar">
      {% for seg in vp.landcover %}
      <div style="width:{{ "%.2f"|format(seg.pct) }}%; background:{{ seg.color }}" title="{{ seg.label }} {{ "%.0f"|format(seg.pct) }}%"></div>
      {% endfor %}
    </div>
    <p class="lc-legend">
      {% for seg in vp.landcover %}{% if seg.pct >= 1 %}<b>{{ "%.0f"|format(seg.pct) }}%</b> {{ seg.label }}{% if not loop.last %} &middot; {% endif %}{% endif %}{% endfor %}
    </p>
    <p class="note">Angular shares of the visible panorama (visual magnitude), not map area.
    Landscape diversity {{ "%.2f"|format(vp.shannon) }} (0&ndash;1 Shannon).</p>
  </div>
</div>

<div class="card">
  <h3 style="margin-top:0">Key numbers</h3>
  <div class="facts">
    <div class="fact"><div class="k">Elevation</div><div class="v">{{ "%.0f"|format(vp.elevation) }} m</div></div>
    <div class="fact"><div class="k">Visible land</div><div class="v">{{ "%.0f"|format(vp.visible_area) }} <small>km²</small></div></div>
    <div class="fact"><div class="k">Farthest sightline</div><div class="v">{{ "%.0f"|format(vp.d_max) }} <small>km</small></div></div>
    <div class="fact"><div class="k">Open arc beyond 10 km</div><div class="v">{{ "%.0f"|format(vp.arc) }}&deg;</div></div>
    <div class="fact"><div class="k">Drop to the vale</div><div class="v">{{ "%.0f"|format(vp.drop) }} <small>m</small></div></div>
    <div class="fact"><div class="k">Downward view angle</div><div class="v">{{ "%.1f"|format(vp.depression) }}&deg;</div></div>
    <div class="fact"><div class="k">Leaf-on retention</div><div class="v">{{ "%.0f"|format(vp.retention * 100) }}<small>%</small></div></div>
    <div class="fact"><div class="k">Grid reference</div><div class="v" style="font-size:15px">{{ vp.grid_ref }}</div></div>
  </div>
</div>

<div class="links-row">
  <a href="{{ vp.gmaps }}">Google Maps</a>
  <a href="{{ vp.osmaps }}">OS Maps</a>
  <a href="{{ vp.osm }}">OpenStreetMap</a>
  <a href="{{ vp.peakfinder }}">PeakFinder panorama</a>
  <a href="{{ vp.geograph }}">Photos of this square (Geograph)</a>
</div>
<p class="note" style="margin-top:14px">
  {{ vp.lat }}, {{ vp.lon }} &middot; source: {{ vp.source }} &middot; position refined by local search.
  Computed location &mdash; check access rights before visiting.
</p>
{% endblock %}
